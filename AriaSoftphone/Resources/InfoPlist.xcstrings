    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria usa la cámara solo para escanear el código QR de configuración de tu centralita."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria nutzt die Kamera nur, um den QR-Code zur Einrichtung deiner Telefonanlage zu scannen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria utilise l’appareil photo uniquement pour scanner le code QR de configuration de votre standard."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria muestra tus contactos para que puedas buscarlos y llamarlos. Tus contactos se quedan en este dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria zeigt deine Kontakte, damit du sie suchen und anrufen kannst. Deine Kontakte bleiben auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria affiche vos contacts pour que vous puissiez les rechercher et les appeler. Vos contacts restent sur cet appareil."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria usa el micrófono para que la otra persona te oiga durante las llamadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria nutzt das Mikrofon, damit dich dein Gegenüber bei Anrufen hört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria utilise le micro pour que votre interlocuteur vous entende pendant les appels."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria nutzt Bluetooth nur, wenn du es in den Einstellungen einschaltest, damit deine Geräte sich erkennen und einen Anruf übergeben können. Nur bei geöffneter App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria usa Bluetooth solo si lo activas en Ajustes, para que tus dispositivos se detecten entre sí y puedan pasarse una llamada. Solo funciona con la app abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aria utilise le Bluetooth uniquement si vous l’activez dans les Réglages, pour que vos appareils se repèrent et puissent se transmettre un appel. Uniquement lorsque l’app est ouverte."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
