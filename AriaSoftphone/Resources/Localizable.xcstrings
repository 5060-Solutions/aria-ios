    "This call isn't encrypted. The phone system didn't accept a secure connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta llamada no está cifrada. La centralita no aceptó una conexión segura."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anruf ist nicht verschlüsselt. Die Telefonanlage hat keine sichere Verbindung akzeptiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel n’est pas chiffré. Le standard n’a pas accepté de connexion sécurisée."
          }
        }
      }
    },
    "This can take up to 45 seconds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede tardar hasta 45 segundos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann bis zu 45 Sekunden dauern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut prendre jusqu’à 45 secondes."
          }
        }
      }
    },
    "This code uses %@, so call signalling will not be encrypted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código usa %@, así que la señalización no irá cifrada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code nutzt %@, die Signalisierung ist also nicht verschlüsselt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code utilise %@ : la signalisation ne sera pas chiffrée."
          }
        }
      }
    },
    "This isn't a valid Aria setup link." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este no es un enlace de configuración de Aria válido."
          }
