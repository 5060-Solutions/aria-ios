          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien ajoutera"
          }
        }
      }
    },
    "This person replied STOP. They can't be texted until they reply START." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta persona respondió STOP. No se le pueden enviar mensajes hasta que responda START."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Person hat mit STOP geantwortet. Sie kann erst wieder Nachrichten erhalten, wenn sie START antwortet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne a répondu STOP. Vous ne pouvez plus lui écrire tant qu’elle n’a pas répondu START."
          }
        }
      }
    },
    "This setup link has expired or was already used. Ask your administrator for a new one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace ha caducado o ya se usó. Pide uno nuevo a tu administrador."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link ist abgelaufen oder wurde schon verwendet. Bitte deine Administration um einen neuen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien a expiré ou a déjà été utilisé. Demandez-en un nouveau à votre administrateur."
          }
        }
      }
    },
