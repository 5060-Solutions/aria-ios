        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielerorts müssen alle Beteiligten wissen, dass ein Anruf aufgezeichnet wird. Sag es der anderen Seite, bevor du aufnimmst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans de nombreux pays, tous les participants doivent savoir que l’appel est enregistré. Prévenez votre interlocuteur avant d’enregistrer."
